# --- Stage 1 : build des dépendances Python ---
# Isolé du stage final pour que gcc/libpq-dev (nécessaires seulement pour
# compiler certains paquets) n'alourdissent jamais l'image qui tourne en prod.
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# --user plutôt qu'un venv classique : plus simple à copier tel quel vers le
# stage final (un seul répertoire, pas de script d'activation à gérer).
RUN pip install --no-cache-dir --user -r requirements.txt

# --- Stage 2 : image d'exécution ---
FROM python:3.12-slim AS runtime

WORKDIR /app

# libpq5 (lib partagée) suffit à l'exécution — pas besoin du compilateur ni
# des en-têtes de dev une fois les paquets Python déjà compilés.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 appuser

COPY --from=builder /root/.local /home/appuser/.local
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini .
COPY infrastructure/docker/entrypoint.backend.sh /entrypoint.sh

RUN chown -R appuser:appuser /app && chmod +x /entrypoint.sh

USER appuser
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
