# Pour le développement backend en local (hors Docker) : copier en backend/.env
# Quand tout tourne via `docker compose`, c'est le .env à la racine du repo qui
# est utilisé à la place (voir ../.env.example) — pas besoin de dupliquer.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/freelancehub
SECRET_KEY=change-me-generate-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
# "development" désactive le garde-fou SECRET_KEY et laisse /docs, /redoc,
# /openapi.json publics. Mettre "production" avant tout déploiement réel
# (voir Phase 12) — l'app refuse alors de démarrer avec la SECRET_KEY par défaut.
ENVIRONMENT=development
# Assistant IA (Phase 9) — clé Anthropic. Sans elle, /ai/* répond 503
# "Assistant IA non configuré" au lieu de planter.
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=30

# Stripe (Phase 10). Sans STRIPE_SECRET_KEY, /billing/* répond 503 au lieu
# de planter. Prix créés via `python scripts/setup_stripe.py` une fois la
# clé renseignée — ne pas les créer à la main dans le Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Monitoring (Phase 19). Vide en dev : aucune erreur locale n'est envoyée à Sentry.
SENTRY_DSN=

# Email transactionnel (Phase 21, Resend). Vide en dev : les liens de
# vérification/reset sont logués au lieu d'être réellement envoyés.
RESEND_API_KEY=
EMAIL_FROM=FreelanceHub <onboarding@resend.dev>
