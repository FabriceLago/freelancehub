# Copier ce fichier en .env et remplir les vraies valeurs.
# Ne jamais committer .env — il est dans .gitignore.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/freelancehub
SECRET_KEY=change-me-generate-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
# "development" désactive le garde-fou SECRET_KEY et laisse /docs, /redoc,
# /openapi.json publics. Mettre "production" avant tout déploiement réel
# (voir Phase 12) — l'app refuse alors de démarrer avec la SECRET_KEY par défaut.
ENVIRONMENT=development

# --- IA (couche AIService — voir Phase 9) ---
# Sans clé, /ai/* répond 503 proprement plutôt que de planter.
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=30

# --- Stripe (voir Phase 10) ---
# Sans STRIPE_SECRET_KEY, /billing/* répond 503 proprement. Les price_id des
# plans payants ne sont PAS des variables d'env : ils sont stockés dans
# plans.stripe_price_id et créés via `python scripts/setup_stripe.py`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# --- Monitoring (Phase 19) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freelancehub

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
